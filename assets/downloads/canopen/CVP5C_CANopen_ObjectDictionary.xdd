            <label lang="en">EV1</label>
            <description lang="en">This Object stores all the parameters relative to the control of Valve-A (EV1).
The value are UINT16 and saved to Object dictionary EEPROM. Can be accessed read-write by SDO 0x2102.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210200" access="read">
