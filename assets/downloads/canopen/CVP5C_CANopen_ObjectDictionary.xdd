            <description lang="en" />
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="-123" />
          </parameter>
          <parameter uniqueID="UID_PARAM_6411" access="readWrite">
            <label lang="en">AnalogInput</label>
            <description lang="en">Enable digital control from CAN Master channel (2 CH - 16bits).

This object can be used to test the system by controlling output current through CAN RX-PDO messages.
RXPDO Mapping over Slot 0x1400.

- CH1_Ref (SubID 0-1): reference channel 1 (max 16 bit)
- CH2_Ref (SubID 2-3): reference channel 2 (max 16 bit)</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="" />
          </parameter>
