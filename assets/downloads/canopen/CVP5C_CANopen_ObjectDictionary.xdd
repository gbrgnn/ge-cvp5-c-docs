            <defaultValue value="7" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210701" access="read">
            <label lang="en">MODEL</label>
            <description lang="en"> /* DEVICE MODEL ID NUMBER*/
 // MODEL = 0 --&gt; CVP5C  - One PWM Out - No Digital Out - No voltage supply control - No Analog Input
 // MODEL = 1 --&gt; CVPC2X - Two PWM Out - Two Digital Out - Voltage Supply Control - One Analog Input
 // MODEL = 2 --&gt; Not Configured.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210702" access="read">
            <label lang="en">EV_NUMBER</label>
            <description lang="en">Number of available PWM output for current valve control.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="1" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210703" access="read">
            <label lang="en">DIGIT_OUT</label>
            <description lang="en">Number of digital output available
0 - Disabled (No Digital Outpput)
1 - Enabled one output
2 - Enabled two output </description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210704" access="read">
            <label lang="en">ADC_VSUPPLY</label>
            <description lang="en">Optional feature - Availability of Analog Reading of the Supply Voltage
0 - disabled
1 - enabled</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210705" access="read">
            <label lang="en">ADC_VCONTR</label>
            <description lang="en">Optional features to control the valve current with external analog voltage
0 - disabled
1 - enabled</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210706" access="read">
            <label lang="en">FW_MAIN_VER</label>
            <description lang="en">Save the Firwmare Version. </description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="1" />
          </parameter>
