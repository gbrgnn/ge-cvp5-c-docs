          <parameter uniqueID="UID_PARAM_6401" access="readWrite">
            <label lang="en">AnalogOutput</label>
            <description lang="en">This Object is mapped to TX PDO slot 0x1800 using all 8 bytes. This object is used to send real-time reading of the following entities:

1. Iread_EV1 (16 bit)- current reading on EV1 in mA
2. Iread_EV2 (16 bit)- current reading on EV2 in mA
3. Vread_Ext (16 bit)- voltage reading on external reference in mV (-123 if not Available)
4. Vread_Spp (16 bit)- supply voltage reading in mV (-123 if not Available)</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="" />
          </parameter>
          <parameter uniqueID="UID_PARAM_640100" access="read">
            <label lang="en">Highest sub-index supported</label>
            <description lang="en" />
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="4" />
          </parameter>
          <parameter uniqueID="UID_PARAM_640101" access="readWrite">
            <label lang="en">Iread_EV1</label>
            <description lang="en" />
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_640102" access="readWrite">
            <label lang="en">Iread_EV2</label>
            <description lang="en" />
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
