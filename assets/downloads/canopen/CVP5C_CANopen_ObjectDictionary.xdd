            <description lang="en" />
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="16" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210201" access="readWrite">
            <label lang="en">Ifull</label>
            <description lang="en">This is the valve FULL CURRENT setting, expressed in mA.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="1000" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210202" access="readWrite">
            <label lang="en">Ioffs</label>
            <description lang="en">This is the valve OFFSET CURRENT setting, expressed in mA.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="200" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210203" access="readWrite">
            <label lang="en">RampUp</label>
            <description lang="en">Current Linear Ramp steepness (rising), expressed in mA/s.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="500" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210204" access="readWrite">
            <label lang="en">RampDw</label>
            <description lang="en">Current Linear Ramp steepness (falling), expressed in mA/s.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="500" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210205" access="readWrite">
            <label lang="en">Dither</label>
            <description lang="en">Dither Factor superimposed to the valve current. Value expressed in % of the valve current. Dither default frequency is 125 Hz.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="10" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210206" access="readWrite">
            <label lang="en">ConvADC</label>
            <description lang="en">Conversion factor between ADC scale (decimal unit) and current value in mA. This value can be corrected with manual calibration during normal operation.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="3070" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210207" access="readWrite">
            <label lang="en">NotLinCoef</label>
            <description lang="en">Compensation of the non linearities of the filter for current reading. Deprecated in october 2023.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="440" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210208" access="readWrite">
            <label lang="en">SysMode</label>
            <description lang="en">Valve reference MODE:

- MODE_AN_0_10V: // ANALOG - MODE 1 - 0V TO 10 V
- MODE_AN_0_5V:  // ANALOG - MODE 2 - 0V TO 5  V
- MODE_AN_5_0V:  // ANALOG - MODE 3 - 5V TO 0  V
- MODE_AN_5_10V: // ANALOG - MODE 4 - 5V TO 10 V
- MODE_DGT:      // DIGITAL- MODE 5 - CAN CONTROLLED</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="5" />
          </parameter>
          <parameter uniqueID="UID_PARAM_210209" access="readWrite">
            <label lang="en">ZeroOffs</label>
            <description lang="en">Zero Offset setting used to bypass offset current by setting valve current to zero until setpoint is reached. Setpoint value is expressed in % of the input scale. E.G. with 16 bit digital input, zero current is set until % of the 26bit input value is reached.

</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020a" access="readWrite">
            <label lang="en">CANBits</label>
            <description lang="en">Number of bits of resolution of the digital reference received over CAN BUS.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="8" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020b" access="readWrite">
            <label lang="en">CAN_CH</label>
            <description lang="en">Digital Input used fro controlling the valve with CAN messages.

With MASTER: The valve is controlled by a controller device with the same ID.
RXPDO Mapping over Slot 0x1400.

- MASTER CH1 --&gt; 0 - (SubID 0-1): reference channel 1 (max 16 bit)
- MASTER CH2 --&gt; 1 - (SubID 2-3): reference channel 2 (max 16 bit)

With EXTERNAL, the device can be controller by any other CANopen device available on the network.
- EXTERNAL DEV --&gt; 2</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020c" access="readWrite">
            <label lang="en">CAN_ID_TARGET_DEV</label>
            <description lang="en">CAN OPEN ID to listend when DIGITAL MODE is on. CAN ID can go from 1 to 127.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020d" access="readWrite">
            <label lang="en">CAN_TARGET_FIELD</label>
            <description lang="en">Sub-Index of the CAN OPEN PDO packet where the data is sent from the external device (0 to 7) byte.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020e" access="readWrite">
            <label lang="en">DIG_DW_REF</label>
            <description lang="en">Digital value sent on from the external CAN device corresponding to Offset Current.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="0" />
          </parameter>
          <parameter uniqueID="UID_PARAM_21020f" access="readWrite">
            <label lang="en">DIG_UP_REF</label>
            <description lang="en">Digital value sent on from the external CAN device corresponding to Full Current.</description>
            <denotation>
              <label lang="en" />
            </denotation>
            <defaultValue value="255" />
          </parameter>
